# NaturalSentinel environment configuration
# Copy to .env and fill in values.

# -- Database --
# For local docker postgres (scripts/setup.sh):
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/naturalsentinel
# For devcontainer (auto-set in containerEnv, no .env needed):
# DATABASE_URL=postgresql://sentinel:sentinel@db:5432/naturalsentinel

# -- Memory store backend --
# Set to a postgresql:// URL to use postgres, or a file path for SQLite
SENTINEL_MEMORY_DB=naturalsentinel_memory.db

# -- LLM Providers --
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# -- Agent --
SENTINEL_PROVIDER=mock
SENTINEL_MODEL=
SENTINEL_STATE=monitor_state.json

# -- Servers --
API_PORT=8000        # FastAPI server (scripts/start_server.sh)
PORT=8080            # MCP server
