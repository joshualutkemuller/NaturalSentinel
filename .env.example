# NaturalSentinel environment configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# =============================================================================
# NaturalSentinel
# =============================================================================

# LLM provider: anthropic | openai | gemini | ollama | mock
SENTINEL_PROVIDER=mock
# Model name (provider-specific, e.g. claude-sonnet-4-20250514, gpt-4o)
SENTINEL_MODEL=
# Agent state file (gitignored)
SENTINEL_STATE=monitor_state.json
# Memory database — file path for SQLite, or a postgresql:// URL
SENTINEL_MEMORY_DB=naturalsentinel_memory.db

# LLM API keys (only the one matching SENTINEL_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# =============================================================================
# Database (Docker Compose Postgres)
# =============================================================================

# Used by the db service in compose.yml and by the backend to connect.
# Inside Docker, POSTGRES_SERVER is overridden to "db" (the service name).
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# =============================================================================
# Backend / FastAPI
# =============================================================================

# URL of your frontend — used by the backend for email links
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="NaturalSentinel"

# Comma-separated allowed CORS origins
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Secret key for JWT tokens — CHANGE THIS in staging/production
SECRET_KEY=changethis

# Initial admin account created on first run
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# =============================================================================
# Email (SMTP)
# =============================================================================

# In local dev, Docker Compose overrides these to use Mailcatcher.
# For staging/production, set real SMTP credentials.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# =============================================================================
# Observability
# =============================================================================

SENTRY_DSN=

# =============================================================================
# Docker images
# =============================================================================

# Names the image that `docker compose build` creates locally.
# The default works fine for local development — no changes needed.
# Only override when pushing to a container registry for deployment, e.g.:
#   DOCKER_IMAGE_BACKEND=ghcr.io/yourorg/naturalsentinel-backend
DOCKER_IMAGE_BACKEND=backend
